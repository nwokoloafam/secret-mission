{
  "name": "secret-mission",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "seed:missions": "tsx scripts/missions-to-sql.ts",
    "dev:cloudflare": "vite dev --port 3001",
    "build:cloudflare": "vite build",
    "preview:cloudflare": "vite preview",
    "deploy:cloudflare": "npm run build:cloudflare && cf deploy --prebuilt",
    "check:cloudflare": "vinext check",
    "build:email-scheduler": "cd workers/email-scheduler && vite build",
    "deploy:email-scheduler": "npm run build:email-scheduler && cd workers/email-scheduler && cf deploy --prebuilt --worker secret-mission-email-scheduler --no-provision"
  },
  "dependencies": {
    "server-only": "^0.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "@vinext/cloudflare": "^1.3.4",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.31",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  }
}
