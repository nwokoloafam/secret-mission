# Copy this file to .env.local for running on your own computer.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never commit the real values.

# Supabase → Connect (top of the project page) → "Transaction pooler" connection string (port 6543),
# with your database password filled in.
DATABASE_URL=

# Supabase → Project Settings → API (or Data API): Project URL
SUPABASE_URL=

# Supabase → Project Settings → API keys: the secret / service_role key (used only for photo uploads)
SUPABASE_SERVICE_ROLE_KEY=

# Apply 0003_notifications.sql before enabling. Off by default.
NOTIFICATIONS_ENABLED=false
# off | dry-run (local previews only) | live (requires verified Brevo sender)
EMAIL_MODE=off
EMAIL_APP_URL=https://game.afamnwokolo.com
EMAIL_DAILY_LIMIT=250
EMAIL_FROM=
BREVO_API_KEY=
# Generate a random secret of at least 32 characters; never use a player/admin token.
EMAIL_DISPATCH_SECRET=
